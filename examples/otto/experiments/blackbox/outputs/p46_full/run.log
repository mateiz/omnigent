    top_idx = np.argsort(yvec)[:min(10, len(yvec))] if len(yvec) > 0 else []
    topX = Xmat[top_idx] if len(top_idx) > 0 else np.array([best_x])

    # Gaussian perturbations around top points
    cov = np.diag((0.08 * span) ** 2)
    i = 0
    while (budget - len(all_attempts)) > 0 and i < n_guided:
        base = topX[i % len(topX)]
