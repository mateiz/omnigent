from scipy.spatial.distance import cdist
from sklearn.gaussian_process import GaussianProcessRegressor
from sklearn.gaussian_process.kernels import Matern, ConstantKernel as C, WhiteKernel

def solve(objective_function, config, best_xs=None):
    bounds = np.array(config['bounds'], dtype=float)
    dim = int(config.get('dim', bounds.shape[0]))
    budget = int(config.get('budget', 100))
    low, high = bounds[:, 0], bounds[:, 1]
    span = np.maximum(1e-12, high - low)

    rng = np.random.default_rng()
    all_attempts = []

    def clip(x):
        return np.clip(x, low, high)

    def eval_x(x):
        x = np.asarray(x, dtype=float)
        x = clip(x)
        score = float(objective_function(x))
        all_attempts.append({"x": x.copy(), "score": score})
        return score

    # Load previous evaluations (do not count against budget)
    prev_points = []
    if best_xs:
        for item in best_xs:
            x = np.asarray(item["x"], dtype=float)
            s = float(item["score"])
            # ignore malformed
            if np.any(~np.isfinite(x)) or not np.isfinite(s) or x.shape[0] != dim:
                continue
            prev_points.append((clip(x), s))
    # Best known so far (from previous)
    if prev_points:
        best_prev_x, best_prev_s = min(prev_points, key=lambda t: t[1])
        best_x, best_s = best_prev_x.copy(), float(best_prev_s)
    else:
        # no prev, start undefined
        best_x, best_s = None, np.inf

    # Zero budget: return best previous or center
    if budget <= 0:
        if best_x is not None:
            return {"x": best_x, "score": best_s, "all_attempts": []}
        x0 = (low + high) / 2.0
        return {"x": x0, "score": float("inf"), "all_attempts": []}

    # Hash helpers to avoid duplicate expensive calls
    def x_hash(x):
        return tuple(np.round(np.asarray(x, float), 12))

    seen = set()
    cache = {}
    # Seed cache/seen with previous
    for x, s in prev_points:
        h = x_hash(x)
        cache[h] = float(s)
        seen.add(h)

    # Latin hypercube sampler
    def latin_hypercube(n_samples, dim, low, high):
        if n_samples <= 0:
            return np.empty((0, dim))
        cut = np.linspace(0, 1, n_samples + 1)
        u = rng.uniform(size=(n_samples, dim))
        a = cut[:n_samples]
        b = cut[1:n_samples + 1]
        rdpoints = u * (b - a)[:, None] + a[:, None]
        for j in range(dim):
            rng.shuffle(rdpoints[:, j])
        return low + rdpoints * (high - low)

    # Evaluate a batch of candidates, skipping duplicates
    def evaluate_batch(cands, remaining):
        nonlocal best_x, best_s
        used = 0
        for x in cands:
            if used >= remaining:
                break
            h = x_hash(x)
            if h in seen:
                # If we have not recorded in all_attempts, we still respect "no re-eval"
                continue
            s = eval_x(x)
            seen.add(h)
            cache[h] = s
            used += 1
            if s < best_s:
                best_s = s
                best_x = np.asarray(x, float).copy()
        return used

    # Ensure at least one evaluation if no previous data
    remaining = budget
    if best_x is None:
        x0 = rng.uniform(low, high)
        remaining -= evaluate_batch([x0], remaining)

    if remaining <= 0:
        return {"x": best_x, "score": best_s, "all_attempts": all_attempts}

    # Build initial diverse seeds: top-K from previous + LHS
    seeds = []
    if prev_points:
        k = max(1, min(8, int(np.sqrt(budget))))
        prev_sorted = sorted(prev_points, key=lambda t: t[1])[:min(len(prev_points), 100)]
        selected = []
        for x, s in prev_sorted:
            if not selected:
                selected.append(x)
            else:
                d = cdist([x], np.array(selected)) [0]
                if np.all(d > 1e-6 * np.linalg.norm(span) + 1e-12):
                    selected.append(x)
            if len(selected) >= k:
                break
        seeds.extend(selected)
    n_lhs = min(max(1, remaining // 6), 20)
    seeds.extend(list(latin_hypercube(n_lhs, dim, low, high)))

    remaining -= evaluate_batch(seeds, remaining)
    if remaining <= 0:
        return {"x": best_x, "score": best_s, "all_attempts": all_attempts}

    # Local pattern search with trust region around good points
    def local_search(x0, steps_budget):
        nonlocal remaining, best_x, best_s
        if steps_budget <= 0 or remaining <= 0:
            return
        x = x0.copy()
        # Start radius smaller if close to bounds
        radius = 0.2 * span
        min_radius = 1e-3 * span
        dirs = np.eye(dim)
        # store current x score
        hx = x_hash(x)
        fx = cache.get(hx, None)
        if fx is None and remaining > 0:
            remaining -= evaluate_batch([x], 1)
            fx = cache.get(hx, np.inf)
        iters_without_improve = 0
        while steps_budget > 0 and remaining > 0:
            improved = False
            # exploratory moves
            order = rng.permutation(dim)
            for j in order:
                for sign in (+1.0, -1.0):
                    if steps_budget <= 0 or remaining <= 0:
                        break
                    cand = clip(x + sign * radius[j] * dirs[j])
                    h = x_hash(cand)
                    sc = cache.get(h, None)
                    if sc is None:
                        remaining -= evaluate_batch([cand], min(1, remaining))
                        sc = cache.get(h, None)
                        steps_budget -= 1
                    if sc is None:
                        continue
                    if sc < fx - 1e-12:
                        x, fx = cand, sc
                        improved = True
                        break
                if improved or steps_budget <= 0 or remaining <= 0:
                    break
            if improved:
                iters_without_improve = 0
                # optional slight radius growth
                radius = np.minimum(span, radius * 1.2)
            else:
                iters_without_improve += 1
                radius = np.maximum(min_radius, radius * 0.5)
                if np.allclose(radius, min_radius) or iters_without_improve >= 3:
                    break

    # Choose a few best observed points (prev + new) for local refinement
    obs_X = [a["x"] for a in all_attempts] + [x for x, _ in prev_points]
    obs_y = [a["score"] for a in all_attempts] + [s for _, s in prev_points]
    if obs_X:
        order = np.argsort(obs_y)
        sorted_X = [obs_X[i] for i in order]
    else:
        sorted_X = [best_x]

    # Allocate budget: some to local, some to model-based global, rest to random
    # Heuristic split
    b_local = max(0, int(0.35 * remaining))
    b_model = max(0, int(0.45 * remaining))
    b_random = max(0, remaining - b_local - b_model)

    # Local searches
    if b_local > 0 and sorted_X:
        n_locals = min(6, max(1, len(sorted_X) // max(1, dim // 2)))
        steps_per_local = max(2, b_local // n_locals)
        for i in range(n_locals):
            if remaining <= 0:
                break
            local_search(sorted_X[i % len(sorted_X)], steps_per_local)

    if remaining <= 0:
        return {"x": best_x, "score": best_s, "all_attempts": all_attempts}

    # Surrogate model (GP with Matern) + Expected Improvement acquisition
    def fit_gp(X, y):
        # Normalize inputs to [0,1]^d and standardize y
        X = np.asarray(X, float)
        y = np.asarray(y, float)
        Xn = (X - low) / span
        y_mean = y.mean()
        y_std = y.std() if y.std() > 1e-12 else 1.0
        yn = (y - y_mean) / y_std
        kernel = C(1.0, (1e-3, 1e3)) * Matern(length_scale=np.ones(dim), length_scale_bounds=(1e-2, 10.0), nu=2.5) + \
                 WhiteKernel(noise_level=1e-6, noise_level_bounds=(1e-9, 1e-2))
        gp = GaussianProcessRegressor(kernel=kernel, alpha=0.0, normalize_y=False, n_restarts_optimizer=2, random_state=rng.integers(1e9))
        gp.fit(Xn, yn)
        return gp, y_mean, y_std

    def expected_improvement(mu, sigma, f_best, xi=0.01):
        # We minimize, so improvement is f_best - f
        from scipy.stats import norm
        sigma = np.maximum(sigma, 1e-12)
        imp = (f_best - mu) - xi
        Z = imp / sigma
        ei = imp * norm.cdf(Z) + sigma * norm.pdf(Z)
        return np.maximum(ei, 0.0)

    # Prepare data for GP
    train_X = []
    train_y = []
    if prev_points:
        for x, s in prev_points:
            train_X.append(x)
            train_y.append(s)
    for a in all_attempts:
        train_X.append(a["x"])
        train_y.append(a["score"])
    # Remove exact duplicates
    if train_X:
        uniq = {}
        for x, y in zip(train_X, train_y):
            h = x_hash(x)
            if h not in uniq or y < uniq[h]:
                uniq[h] = y
        train_X = [np.array(k, float) for k in uniq.keys()]
        train_y = [uniq[x_hash(x)] for x in train_X]

    # Model-guided global proposals
    if b_model > 0 and len(train_X) >= max(3, dim + 1):
        try:
            gp, y_mean, y_std = fit_gp(train_X, train_y)
            f_best = (min(train_y) - y_mean) / (y_std if y_std > 1e-12 else 1.0)
            # Generate candidate pool: mix of LHS and local perturbations around best few
            n_pool = min(2000, max(200, 20 * dim))
            n_from_best = max(10, n_pool // 5)
            pool = []
            # LHS
            pool.extend(latin_hypercube(n_pool - n_from_best, dim, low, high))
            # Gaussian around top few points
            topk = min(8, len(sorted_X))
            if topk == 0 and best_x is not None:
                sorted_X = [best_x]
                topk = 1
            cov = (0.1 * span) ** 2
            for i in range(n_from_best):
                base = np.asarray(sorted_X[i % topk])
                cand = base + rng.normal(scale=np.sqrt(cov))
                pool.append(clip(cand))
            pool = np.asarray(pool, float)
            # Score EI
            Xn = (pool - low) / span
            mu, std = gp.predict(Xn, return_std=True)
            ei = expected_improvement(mu, std, f_best)
            # Density penalty to avoid already seen regions
            if len(train_X) > 0:
                seen_X = (np.asarray(train_X) - low) / span
                d = cdist(Xn, seen_X)
                # distance to nearest known point
                dn = d.min(axis=1)
                # Encourage exploration: multiply EI by (1 + lambda * distance)
                lam = 0.2
                ei = ei * (1.0 + lam * dn)
            # Select top candidates by EI
            idx = np.argsort(-ei)
            top_cands = []
            taken = 0
            for i in idx:
                if taken >= b_model:
                    break
                x = pool[i]
                if x_hash(x) in seen:
                    continue
                top_cands.append(x)
                taken += 1
            remaining -= evaluate_batch(top_cands, min(b_model, remaining))
        except Exception:
            # Fallback: random if GP fails
            cands = rng.uniform(low, high, size=(min(b_model, remaining), dim))
            remaining -= evaluate_batch(cands, remaining)

    if remaining <= 0:
        return {"x": best_x, "score": best_s, "all_attempts": all_attempts}

    # Final random/global exploration: mixture of LHS and Gaussian around best
    n_final = remaining
    n_gauss = min(max(0, n_final // 2), max(1, n_final - 3))
    n_rand = n_final - n_gauss
    finals = []
    if n_rand > 0:
        finals.extend(latin_hypercube(n_rand, dim, low, high))
    if n_gauss > 0:
        bases = sorted_X[:max(1, min(5, len(sorted_X)))] if sorted_X else [best_x]
        sigma2 = (0.08 * span) ** 2
        for i in range(n_gauss):
            base = bases[i % len(bases)]
            finals.append(clip(base + rng.normal(scale=np.sqrt(sigma2))))
    remaining -= evaluate_batch(finals, remaining)

    # Ensure we return a feasible best_x
    if best_x is None:
        # Should not happen, but guard anyway
        x0 = (low + high) / 2.0
        s0 = cache.get(x_hash(x0))
        if s0 is None:
            s0 = eval_x(x0)
        best_x, best_s = x0, s0

    return {"x": np.asarray(best_x, float), "score": float(best_s), "all_attempts": all_attempts}
