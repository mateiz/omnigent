            x = np.asarray(item["x"], dtype=float)
            s = float(item["score"])
            if x.shape[0] == dim and np.all(np.isfinite(x)) and np.isfinite(s):
                prev_points.append((clip(x), s))

    # If no budget, return best previously known or center
    if budget <= 0:
        if prev_points:
            x_best, s_best = min(prev_points, key=lambda t: t[1])
            return {"x": x_best, "score": s_best, "all_attempts": []}
        x0 = (low + high) / 2.0
        return {"x": x0, "score": float("inf"), "all_attempts": []}

    # Set up caches/sets
    eval_cache = {}
    seen = set()

    def x_hash(x):
        return tuple(np.round(x, 12))

    # Seed with best previous if available; otherwise one random eval
    if prev_points:
        best_x, best_s = min(prev_points, key=lambda t: t[1])
    else:
        x0 = rng.uniform(low, high)
        s0 = eval_x(x0)
        best_x, best_s = x0.copy(), s0
        seen.add(x_hash(x0))

    remaining = budget - len(all_attempts)
    if remaining <= 0:
        return {"x": best_x, "score": best_s, "all_attempts": all_attempts}

    # Helper samplers
    def latin_hypercube(n_samples, dim, low, high):
        if n_samples <= 0:
            return np.empty((0, dim))
        cut = np.linspace(0, 1, n_samples + 1)
        u = rng.uniform(size=(n_samples, dim))
        a = cut[:-1]
        b = cut[1:]
        pts = u * (b - a)[:, None] + a[:, None]
        for j in range(dim):
            rng.shuffle(pts[:, j])
        return low + pts * (high - low)

    def random_perturb_around(base, scale):
        cand = base + rng.normal(scale=scale, size=dim)
        return clip(cand)

