    prev_X = np.array(prev_X) if len(prev_X) > 0 else np.empty((0, dim))
    prev_y = np.array(prev_y) if len(prev_y) > 0 else np.empty((0,))

    # Utility: Latin Hypercube Sampling
    def latin_hypercube(n_samples):
        if n_samples <= 0:
            return np.empty((0, dim))
        cut = np.linspace(0, 1, n_samples + 1)
        u = rng.uniform(size=(n_samples, dim))
        a = cut[:n_samples]
        b = cut[1:n_samples + 1]
        pts = u * (b - a)[:, None] + a[:, None]
        for j in range(dim):
            rng.shuffle(pts[:, j])
        return low + pts * (high - low)

    # Hashing to avoid exact duplicates
    def x_hash(x):
        return tuple(np.round(np.asarray(x, dtype=float), 12))

    seen = set()
    # Seed seen with previous evaluations
    for i in range(prev_X.shape[0]):
        seen.add(x_hash(prev_X[i]))

    # If no budget, return best previous or center
    if budget <= 0:
        if prev_X.shape[0] > 0:
            idx = np.argmin(prev_y)
            return {"x": prev_X[idx].copy(), "score": float(prev_y[idx]), "all_attempts": []}
        x0 = (low + high) / 2.0
        return {"x": x0, "score": float("inf"), "all_attempts": []}

    # Initialize with best previous if any, else one random eval
    if prev_X.shape[0] > 0:
        best_idx = int(np.argmin(prev_y))
        best_x = prev_X[best_idx].copy()
        best_s = float(prev_y[best_idx])
    else:
        x0 = rng.uniform(low, high)
        s0 = eval_x(x0)
        best_x, best_s = x0.copy(), s0

    remaining = budget - len(all_attempts)
    if remaining <= 0:
        return {"x": best_x, "score": best_s, "all_attempts": all_attempts}

    # 1) Evaluate a diverse batch of seeds: mix top-K prev + LHS
    seeds = []
    if prev_X.shape[0] > 0:
