from scipy.spatial.distance import cdist
from sklearn.gaussian_process import GaussianProcessRegressor
from sklearn.gaussian_process.kernels import Matern, ConstantKernel as C, WhiteKernel

def solve(objective_function, config, best_xs=None):
    bounds = np.array(config['bounds'], dtype=float)
    dim = int(config.get('dim', bounds.shape[0]))
    budget = int(config.get('budget', 100))
    low, high = bounds[:, 0], bounds[:, 1]
    span = np.maximum(1e-12, high - low)

    rng = np.random.default_rng()
    all_attempts = []

    def clip(x):
        return np.clip(x, low, high)

    def eval_x(x):
        x = np.asarray(x, dtype=float)
        x = clip(x)
        s = float(objective_function(x))
        all_attempts.append({"x": x.copy(), "score": s})
        seen_hash.add(x_hash(x))
        cache[x_hash(x)] = s
        return s

    def x_hash(x):
        return tuple(np.round(np.asarray(x, dtype=float), 12))

    # Gather previous data (do not count against budget)
    prev_X, prev_y = [], []
    if best_xs:
        for item in best_xs:
            x = np.asarray(item["x"], dtype=float)
            y = float(item["score"])
            prev_X.append(x)
            prev_y.append(y)
    prev_X = np.array(prev_X) if prev_X else np.empty((0, dim))
    prev_y = np.array(prev_y, dtype=float) if prev_y else np.empty((0,))

    # Early exit if no budget
    if budget <= 0:
        if len(prev_y) > 0:
            i = int(np.argmin(prev_y))
            return {"x": prev_X[i], "score": float(prev_y[i]), "all_attempts": []}
        x0 = (low + high) / 2.0
        return {"x": x0, "score": float("inf"), "all_attempts": []}

    # Tracking seen points and cache of scores
    seen_hash = set()
    cache = {}
    for i in range(len(prev_X)):
        seen_hash.add(x_hash(prev_X[i]))
        cache[x_hash(prev_X[i])] = float(prev_y[i])

    # Latin hypercube sampling
    def latin_hypercube(n_samples, dim, low, high):
        cut = np.linspace(0, 1, n_samples + 1)
        u = rng.uniform(size=(n_samples, dim))
        a = cut[:n_samples]
        b = cut[1:n_samples + 1]
        rd = u * (b - a)[:, None] + a[:, None]
        for j in range(dim):
            rng.shuffle(rd[:, j])
        return low + rd * (high - low)

    # Utility: pick diverse subset by greedy max-min distance
    def diverse_select(X, k):
        if len(X) == 0:
            return []
        if len(X) <= k:
            return list(range(len(X)))
        X = np.asarray(X)
        sel = [int(np.argmin(prev_y))] if len(prev_y) else [0]
        cand = set(range(len(X))) - set(sel)
        while len(sel) < k and cand:
            d = cdist(X[list(cand)], X[sel])
            md = d.min(axis=1)
            idx = list(cand)[int(np.argmax(md))]
            sel.append(idx)
            cand.remove(idx)
        return sel

    # Initialize with best previous or random
    best_x = None
    best_s = float("inf")
    if len(prev_y) > 0:
        i = int(np.argmin(prev_y))
        best_x, best_s = prev_X[i].copy(), float(prev_y[i])
    else:
        x0 = rng.uniform(low, high)
        s0 = eval_x(x0)
        best_x, best_s = x0.copy(), s0

    remaining = budget - len(all_attempts)
    if remaining <= 0:
        return {"x": best_x, "score": best_s, "all_attempts": all_attempts}

    # Build a seed set: top-K previous + LHS
    seeds = []
