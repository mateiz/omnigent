                        remaining -= 1
                        steps_left -= 1
                        if s < best_s:
                            best_x, best_s = cand.copy(), s
                        if s + 1e-12 < cache_val.get(x_hash(x), np.inf):
                            cache_val[x_hash(cand)] = s
                            x = cand
                            improved = True
                        if steps_left <= 0 or remaining <= 0:
