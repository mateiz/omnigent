        return np.clip(x, low, high)

    def x_hash(x):
        return tuple(np.round(np.asarray(x, dtype=float), 12))

    def eval_x(x):
        x = np.asarray(x, dtype=float)
        x = clip(x)
        h = x_hash(x)
        if h in seen:  # prevent duplicate evaluations within this call
            # Do not consume budget, and do not append duplicate attempt
            return seen[h]
        s = float(objective_function(x))
        all_attempts.append({"x": x.copy(), "score": s})
        seen[h] = s
        return s

