            # However, per requirement evaluations count, so do not call objective again
            s = eval_x.cache[h]
            all_attempts.append({"x": x.copy(), "score": float(s)})
            return float(s)
        s = float(objective_function(x))
        eval_x.cache[h] = s
        all_attempts.append({"x": x.copy(), "score": s})
        return s

