        cur_h = x_hash(x_cur)
        cur_val = seen.get(cur_h, None)
        if cur_val is None and (budget - len(all_attempts)) > 0:
            cur_val = eval_x(x_cur)
            used += 1
        elif cur_val is None:
            return used

        while used < steps_left and (budget - len(all_attempts)) > 0:
            improved = False
            # explore +/- along axes
            for sign in (+1.0, -1.0):
                for d in dirs:
                    if used >= steps_left or (budget - len(all_attempts)) <= 0:
                        break
                    cand = clip(x_cur + sign * radius * d)
                    s = eval_x(cand)
                    used += 1
                    if s < best_s:
                        best_x, best_s = cand.copy(), float(s)
                    if s + 1e-12 < cur_val:
                        x_cur, cur_val = cand, float(s)
                        improved = True
                if used >= steps_left or (budget - len(all_attempts)) <= 0:
                    break
            if not improved:
                # try diagonal moves to escape axis-aligned plateaus
                for sign in (+1.0, -1.0):
                    if used >= steps_left or (budget - len(all_attempts)) <= 0:
                        break
                    diag = np.ones(dim) / np.sqrt(dim)
                    cand = clip(x_cur + sign * radius * diag)
                    s = eval_x(cand)
                    used += 1
                    if s < best_s:
                        best_x, best_s = cand.copy(), float(s)
                    if s + 1e-12 < cur_val:
                        x_cur, cur_val = cand, float(s)
                        improved = True
                if not improved:
                    radius = np.maximum(min_radius, 0.5 * radius)
                    # if stuck at min radius, stop local search
                    if np.all(radius <= min_radius * (1 + 1e-12)):
                        break
                else:
                    # modest expansion if improvement found
                    radius = np.minimum(max_radius, radius * 1.5)
        return used

    # Allocate fraction of remaining budget to local searches
    remaining = budget - len(all_attempts)
    if remaining > 0 and centers:
        n_locals = min(len(centers), max(1, remaining // 12))
        steps_per_local = max(3, remaining // max(1, n_locals))
        for i in range(n_locals):
            if (budget - len(all_attempts)) <= 0:
                break
            pattern_search(centers[i], steps_per_local)

    remaining = budget - len(all_attempts)
    if remaining <= 0:
        return {"x": best_x, "score": best_s, "all_attempts": all_attempts}

    # Final global exploration guided by simple RBF-like surrogate from observed data
    # Build lightweight surrogate: inverse distance weighting
    obs_X = [a["x"] for a in all_attempts] + [x for x, _ in prev_points]
    obs_y = [a["score"] for a in all_attempts] + [s for _, s in prev_points]
    Xmat = np.array(obs_X) if len(obs_X) > 0 else np.empty((0, dim))
    yvec = np.array(obs_y) if len(obs_y) > 0 else np.empty((0,))

    def surrogate_predict(x):
        if Xmat.shape[0] == 0:
            return 0.0
        d = np.linalg.norm((Xmat - x) / span, axis=1) + 1e-12
        w = 1.0 / (d ** 2)
        return float(np.sum(w * yvec) / np.sum(w))

