        order = np.argsort(prev_y)[:min(len(prev_y), 50)]
        top_prev = prev_X[order]
        idxs = diverse_select(top_prev, k_prev)
        seeds.extend([top_prev[i] for i in idxs])

    n_lhs = max(0, min(10, remaining // 4))
    if n_lhs > 0:
        lhs = latin_hypercube(n_lhs, dim, low, high)
        for i in range(n_lhs):
            seeds.append(lhs[i])

    if not seeds:
