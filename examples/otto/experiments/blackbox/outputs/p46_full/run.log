            s = eval_x(cand)
            seen.add(h)
            remaining -= 1
            if s < best_s:
                best_x, best_s = cand.copy(), s
            if remaining <= 0:
                break

    # LHS random exploration
    if remaining > 0 and n_rand > 0:
        lhs = latin_hypercube(n_rand, dim, low, high)
        for i in range(lhs.shape[0]):
