                    if h in seen:
                        continue
                    s = eval_x(cand)
                    seen.add(h)
                    remaining -= 1
                    steps_budget -= 1
                    if s < best_s:
                        best_x, best_s = cand.copy(), s
                    if s < fx - 1e-12:
                        x, fx = cand, s
                        improved = True
            if not improved:
                radius = np.maximum(min_radius, radius * 0.5)
                no_improve_rounds += 1
                if np.allclose(radius, min_radius) or no_improve_rounds >= 3:
                    break
            else:
                # try a slight expansion after improvement
                radius = np.minimum(span, radius * 1.2)

    n_locals = min(len(topX), max(1, remaining // 12))
    steps_per_local = max(3, remaining // max(1, n_locals + 2))
    for i in range(n_locals):
        if remaining <= 0:
            break
        local_search(topX[i], steps_per_local)

    if remaining <= 0:
        return {"x": best_x, "score": best_s, "all_attempts": all_attempts}

    # Surrogate-guided global exploration using GP with UCB acquisition
    Xobs, yobs = get_known_dataset()
    if len(Xobs) >= 5 and remaining > 0:
        # Normalize inputs to [0,1]^d for GP stability
        Xn = (Xobs - low) / span
        yn = yobs
        # Kernel with automatic relevance determination and noise
        kernel = C(1.0, (1e-3, 1e3)) * Matern(length_scale=np.ones(dim), length_scale_bounds=(1e-2, 10.0), nu=2.5) + WhiteKernel(noise_level=1e-6, noise_level_bounds=(1e-9, 1e-2))
        gp = GaussianProcessRegressor(kernel=kernel, normalize_y=True, n_restarts_optimizer=2, random_state=rng.integers(0, 2**31 - 1))
        try:
            gp.fit(Xn, yn)
            # Acquisition: Lower Confidence Bound (LCB) = mu - kappa * sigma, minimize
            def propose_ucb(n_candidates=256, kappa=1.5):
                Z = rng.uniform(size=(n_candidates, dim))
                mu, std = gp.predict(Z, return_std=True)
                acq = mu - kappa * std
