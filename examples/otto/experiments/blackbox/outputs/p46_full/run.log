                    if np.allclose(radius, min_radius):
                        break

    if remaining <= 0:
        return {"x": best_x, "score": best_s, "all_attempts": all_attempts}

    # Final global exploration: mix of LHS and Gaussian perturbations around best set
    n_global = remaining
    n_gauss = n_global // 2
    n_rand = n_global - n_gauss
    base_pts = None
    if len(X) > 0 and len(y) > 0:
