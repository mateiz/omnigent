        return {"x": x0, "score": float("inf"), "all_attempts": []}

    # Seed selection: top-K diverse from prev + LHS
    def latin_hypercube(n_samples, d, lo, hi):
        if n_samples <= 0:
            return np.empty((0, d))
        cut = np.linspace(0, 1, n_samples + 1)
        u = rng.uniform(size=(n_samples, d))
        a = cut[:-1][:, None]
        b = cut[1:][:, None]
        rd = a + (b - a) * u
        for j in range(d):
