        prev_sorted = sorted(prev_points, key=lambda t: t[1])[:min(len(prev_points), 100)]
        selected = []
        min_div = 1e-6 * np.linalg.norm(span) + 1e-12
        for x, s in prev_sorted:
            if not selected:
                selected.append((x, s))
            else:
                dists = cdist([x], [p[0] for p in selected])[0]
                if np.all(dists > min_div):
                    selected.append((x, s))
            if len(selected) >= k:
                break
        seeds.extend([x for x, _ in selected])

    # Add LHS exploration seeds
    n_lhs = max(0, min(remaining // 3, 20))
    if n_lhs > 0:
