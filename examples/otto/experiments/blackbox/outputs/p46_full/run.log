    prev_points = []
    if best_xs:
        for item in best_xs:
            xi = np.asarray(item["x"], dtype=float)
            si = float(item["score"])
            prev_points.append((clip(xi), si))

    # Initialize seen cache with previous points to avoid re-evaluations
    seen = {}
    for x, s in prev_points:
        seen[x_hash(x)] = s

    # If no budget left, return best previous or center
    if budget <= 0:
        if prev_points:
            best_prev = min(prev_points, key=lambda t: t[1])
            return {"x": best_prev[0], "score": best_prev[1], "all_attempts": []}
        x0 = (low + high) / 2.0
        return {"x": x0, "score": float("inf"), "all_attempts": []}

    # Determine current best from previous data if any
    if prev_points:
        best_x, best_s = min(prev_points, key=lambda t: t[1])
        best_x = best_x.copy()
        best_s = float(best_s)
    else:
        # one random eval to seed
        x0 = rng.uniform(low, high)
        s0 = eval_x(x0)
        best_x, best_s = x0.copy(), s0

    remaining = budget - len(all_attempts)
    if remaining <= 0:
        return {"x": best_x, "score": best_s, "all_attempts": all_attempts}

    # Latin Hypercube Sampling
    def latin_hypercube(n_samples, dim, low, high):
        if n_samples <= 0:
            return np.empty((0, dim))
        cut = np.linspace(0, 1, n_samples + 1)
        u = rng.uniform(size=(n_samples, dim))
        a = cut[:n_samples]
        b = cut[1:n_samples + 1]
        rdpoints = u * (b - a)[:, None] + a[:, None]
        for j in range(dim):
            rng.shuffle(rdpoints[:, j])
        return low + rdpoints * (high - low)

