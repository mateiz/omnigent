from scipy.spatial.distance import cdist
from sklearn.gaussian_process import GaussianProcessRegressor
from sklearn.gaussian_process.kernels import Matern, ConstantKernel as C, WhiteKernel
from scipy.optimize import minimize

def solve(objective_function, config, best_xs=None):
    bounds = np.array(config['bounds'], dtype=float)
    dim = int(config.get('dim', bounds.shape[0]))
    budget = int(config.get('budget', 100))
    low, high = bounds[:, 0], bounds[:, 1]
    span = np.maximum(1e-12, high - low)

    rng = np.random.default_rng()
    all_attempts = []

    def clip(x):
        return np.clip(x, low, high)

    def eval_x(x):
        x = np.asarray(x, dtype=float)
        x = clip(x)
        score = float(objective_function(x))
        all_attempts.append({"x": x.copy(), "score": score})
        return score

    # Load previous points (do not count against budget)
    prev_points = []
    if best_xs:
        for item in best_xs:
            x = np.asarray(item["x"], dtype=float)
            s = float(item["score"])
            # keep only points within bounds
            x = clip(x)
            prev_points.append((x, s))

    # If no budget, return best previous if any
    if budget <= 0:
        if prev_points:
            best_prev = min(prev_points, key=lambda t: t[1])
            return {"x": best_prev[0], "score": best_prev[1], "all_attempts": []}
        x0 = (low + high) / 2.0
        return {"x": x0, "score": float("inf"), "all_attempts": []}

    # Hash utilities to avoid duplicate evals
    def x_hash(x):
        return tuple(np.round(np.asarray(x, dtype=float), 12))

    seen = set()

    # Seed from previous best
    if prev_points:
        best_x, best_s = min(prev_points, key=lambda t: t[1])
        best_x = best_x.copy()
        best_s = float(best_s)
    else:
        # one random eval to establish a best
        x0 = rng.uniform(low, high)
        best_s = eval_x(x0)
        best_x = x0.copy()
        seen.add(x_hash(x0))

    remaining = budget - len(all_attempts)
    if remaining <= 0:
        return {"x": best_x, "score": best_s, "all_attempts": all_attempts}

    # Helper: Latin Hypercube Sampling
    def latin_hypercube(n_samples, d, low_b, high_b):
        if n_samples <= 0:
            return np.empty((0, d))
        cut = np.linspace(0, 1, n_samples + 1)
        u = rng.uniform(size=(n_samples, d))
        a = cut[:n_samples]
        b = cut[1:n_samples + 1]
        rdpoints = u * (b - a)[:, None] + a[:, None]
        for j in range(d):
            rng.shuffle(rdpoints[:, j])
        return low_b + rdpoints * (high_b - low_b)

    # Evaluate a set of seeds: top-K from prev (diverse) + LHS
    seeds = []
    if prev_points:
        k = max(1, min(10, int(np.sqrt(remaining) + 1)))
        prev_sorted = sorted(prev_points, key=lambda t: t[1])[:min(len(prev_points), 100)]
        selected = []
        min_sep = 1e-3 * np.linalg.norm(span) + 1e-12
        for x, s in prev_sorted:
            if not selected:
                selected.append((x, s))
            else:
                dists = cdist([x], [p[0] for p in selected])[0]
                if np.all(dists > min_sep):
                    selected.append((x, s))
            if len(selected) >= k:
                break
        seeds.extend([x for x, _ in selected])

    n_lhs = max(0, min(remaining // 3, 20))
    if n_lhs > 0:
        lhs = latin_hypercube(n_lhs, dim, low, high)
        seeds.extend([lhs[i] for i in range(n_lhs)])

    if not seeds:
        seeds = [rng.uniform(low, high)]

    # Evaluate seeds (without duplicating exact prev points)
    # Fill seen with prev hashes to avoid re-evaluating exact same x in this budget
    for x, s in prev_points:
        seen.add(x_hash(x))

    for x in seeds:
        if remaining <= 0:
            break
        h = x_hash(x)
        if h in seen:
            continue
        s = eval_x(x)
        seen.add(h)
        remaining -= 1
        if s < best_s:
            best_x, best_s = x.copy(), s

    if remaining <= 0:
        return {"x": best_x, "score": best_s, "all_attempts": all_attempts}

    # Build dataset for surrogate (prev + newly evaluated)
    obs_X = np.array([a["x"] for a in all_attempts] + [x for x, _ in prev_points], dtype=float)
    obs_y = np.array([a["score"] for a in all_attempts] + [s for _, s in prev_points], dtype=float)
    # Deduplicate obs_X for GP stability
    if len(obs_X) > 0:
        _, idx_unique = np.unique(np.round(obs_X, 10), axis=0, return_index=True)
        obs_X = obs_X[np.sort(idx_unique)]
        obs_y = obs_y[np.sort(idx_unique)]

    # Surrogate: GP with Matern kernel
    def fit_gp(X, y):
        # Normalize X to [0,1] for GP stability
        Xn = (X - low) / span
        y_center = np.median(y)
        y_scale = np.std(y - y_center) + 1e-9
        yn = (y - y_center) / y_scale
        kernel = C(1.0, (1e-3, 1e3)) * Matern(length_scale=np.ones(dim), length_scale_bounds=(1e-2, 10.0), nu=2.5) + WhiteKernel(noise_level=1e-5, noise_level_bounds=(1e-8, 1e-2))
        gp = GaussianProcessRegressor(kernel=kernel, alpha=0.0, normalize_y=False, n_restarts_optimizer=2, random_state=rng.integers(0, 2**32 - 1))
        try:
            gp.fit(Xn, yn)
            return gp, y_center, y_scale
        except Exception:
            return None, y_center, y_scale

    # Expected Improvement acquisition
    def expected_improvement(mu, sigma, f_best, xi=0.01):
        sigma = np.maximum(sigma, 1e-12)
        imp = f_best - mu - xi
        Z = imp / sigma
        from scipy.stats import norm
        ei = imp * norm.cdf(Z) + sigma * norm.pdf(Z)
        return np.maximum(ei, 0.0)

    # Optimize acquisition by multi-start and local L-BFGS on scaled space
    def optimize_acq(gp, y_center, y_scale, f_best_scaled, n_starts, iters):
        Xcands = []
        Acands = []
        # random starts + around good observed
        n_rand = max(2, n_starts // 2)
        starts = []
        starts.extend((rng.uniform(low, high) for _ in range(n_rand)))
        if len(obs_X) > 0:
            topk = min(10, len(obs_X))
            idx = np.argsort(obs_y)[:topk]
            for i in idx:
                # jitter around best observed
                base = obs_X[i]
                for _ in range(max(1, n_starts // topk)):
                    jitter = rng.normal(scale=0.15, size=dim) * span
                    starts.append(clip(base + jitter))

        def acq_val(x):
            x = clip(x)
            xn = (x - low) / span
            mu, std = gp.predict(xn.reshape(1, -1), return_std=True)
            mu = mu[0] * y_scale + y_center
            std = std[0] * y_scale
            # EI for minimization
            return -expected_improvement(mu, std, f_best_scaled, xi=0.01)

        bounds_lbfgs = [(0.0, 1.0)] * dim
        for x0 in starts[:n_starts]:
            xn0 = (x0 - low) / span
            try:
                res = minimize(lambda z: acq_val(low + np.clip(z, 0, 1) * span),
                               np.clip(xn0, 0, 1),
                               method="L-BFGS-B",
                               bounds=bounds_lbfgs,
                               options={"maxiter": iters, "ftol": 1e-6})
                xopt = low + np.clip(res.x, 0, 1) * span
            except Exception:
                xopt = x0
            mu, std = gp.predict(((xopt - low) / span).reshape(1, -1), return_std=True)
            mu = mu[0] * y_scale + y_center
            std = std[0] * y_scale
            ei = expected_improvement(mu, std, f_best_scaled, xi=0.01)
            Xcands.append(clip(xopt))
            Acands.append(ei)
        if len(Xcands) == 0:
            return None
        idx_best = int(np.argmax(Acands))
        return Xcands[idx_best]

    # Trust-region pattern search around selected elites
    def local_search(x0, steps_budget, base_radius_frac=0.2):
        nonlocal best_x, best_s, remaining
        if steps_budget <= 0 or remaining <= 0:
            return
        x_cur = x0.copy()
        # evaluate center if not seen within this session
        hcur = x_hash(x_cur)
        cur_s = None
        if hcur in seen:
            # attempt to recover score from prev_points or all_attempts
            for a in all_attempts:
                if x_hash(a["x"]) == hcur:
                    cur_s = a["score"]
                    break
            if cur_s is None:
                for (px, ps) in prev_points:
                    if x_hash(px) == hcur:
                        cur_s = ps
                        break
        if cur_s is None:
            if remaining <= 0:
                return
            cur_s = eval_x(x_cur)
            seen.add(hcur)
            remaining -= 1
            if cur_s < best_s:
                best_x, best_s = x_cur.copy(), cur_s

        radius = np.maximum(0.5 * span, base_radius_frac * span)
        min_radius = 1e-3 * span
        directions = np.vstack([np.eye(dim), -np.eye(dim)])
        no_improve_rounds = 0
        while steps_budget > 0 and remaining > 0:
            improved = False
            # explore in random order
            order = rng.permutation(len(directions))
            for idx in order:
                if steps_budget <= 0 or remaining <= 0:
                    break
                step = directions[idx] * radius
                cand = clip(x_cur + step)
                h = x_hash(cand)
                if h in seen:
                    steps_budget -= 1  # count as an attempted direction to bound total work
                    continue
                s = eval_x(cand)
                seen.add(h)
                remaining -= 1
                steps_budget -= 1
                if s < best_s:
                    best_x, best_s = cand.copy(), s
                if s + 1e-12 < cur_s:
                    x_cur, cur_s = cand, s
                    improved = True
                    # opportunistic move: try same direction again with larger step if budget permits
                    radius = np.minimum(0.75 * span, np.maximum(min_radius, 1.2 * radius))
                    break
            if not improved:
                no_improve_rounds += 1
                radius = np.maximum(min_radius, 0.5 * radius)
                if np.all(radius <= min_radius) or no_improve_rounds >= 3:
                    break

    # Allocate remaining evaluations between BO (surrogate) and local/global
    # Strategy:
    # - Use a chunk for Bayesian Optimization guided by GP if we have enough data
    # - Run local searches from top elites
    # - Use the rest for global exploration (LHS + Gaussian around elites)

    # Determine elites from observed (prev + current)
    if len(prev_points) + len(all_attempts) > 0:
        allX_mix = [a["x"] for a in all_attempts] + [x for x, _ in prev_points]
        ally_mix = [a["score"] for a in all_attempts] + [s for _, s in prev_points]
        order = np.argsort(ally_mix)
        elites = [allX_mix[i] for i in order[:min(8, len(order))]]
    else:
        elites = [best_x]

    # 1) Bayesian Optimization phase
    bo_steps = max(0, remaining // 3)
    if bo_steps > 0 and len(obs_X) >= max(5, dim + 1):
        gp, y_center, y_scale = fit_gp(obs_X, obs_y)
        if gp is not None:
            # best f for EI
            f_best = np.min(obs_y)
            f_best_scaled = f_best
            n_per_iter = 1
            while bo_steps > 0 and remaining > 0:
                x_cand = optimize_acq(gp, y_center, y_scale, f_best_scaled, n_starts=max(10, 3 * dim), iters=50)
                if x_cand is None:
                    break
                h = x_hash(x_cand)
                if h in seen:
                    # fallback random if duplicate
                    x_cand = rng.uniform(low, high)
                    h = x_hash(x_cand)
                    if h in seen:
                        bo_steps -= 1
                        continue
                s = eval_x(x_cand)
                seen.add(h)
                remaining -= 1
                bo_steps -= 1
                if s < best_s:
                    best_x, best_s = x_cand.copy(), s
                # update GP incrementally (cheap refit for robustness)
                obs_X = np.vstack([obs_X, x_cand])
                obs_y = np.append(obs_y, s)
                gp, y_center, y_scale = fit_gp(obs_X, obs_y)
                if gp is None:
                    break

    if remaining <= 0:
        return {"x": best_x, "score": best_s, "all_attempts": all_attempts}

    # 2) Local searches from elites
    n_locals = min(len(elites), max(1, remaining // max(6, 2 * dim)))
    local_steps_each = max(2 * dim, remaining // max(1, n_locals + 1))
    for i in range(n_locals):
        if remaining <= 0:
            break
        local_search(elites[i], local_steps_each)

    if remaining <= 0:
        return {"x": best_x, "score": best_s, "all_attempts": all_attempts}

    # 3) Global exploration: mix of LHS and Gaussian perturbations around elites
    n_global = remaining
    n_gauss = min(len(elites) * 2, n_global // 2)
    n_rand = n_global - n_gauss

    # Gaussian exploitation around elites
    if n_gauss > 0:
        cov = np.diag((0.1 * span) ** 2)
        for i in range(n_gauss):
            base = elites[i % len(elites)]
            cand = rng.multivariate_normal(mean=base, cov=cov)
