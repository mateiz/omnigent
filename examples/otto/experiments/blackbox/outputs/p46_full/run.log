        k = max(1, min(10, int(np.sqrt(max(remaining, 1))) + 2))
        order = np.argsort(prev_y)[:min(len(prev_y), 100)]
        cand = prev_X[order]
        selected = []
        for x in cand:
            if len(selected) == 0:
                selected.append(x)
            else:
                dmin = np.min(cdist([x], selected))
                if dmin > 1e-6 * np.linalg.norm(span):
                    selected.append(x)
            if len(selected) >= k:
                break
        seeds.extend([x.copy() for x in selected])
    n_lhs = max(0, min(remaining // 3, 15))
    if n_lhs > 0:
        seeds.extend(list(latin_hypercube(n_lhs, dim, low, high)))

    if not seeds:
        seeds = [rng.uniform(low, high)]

    # Evaluate seeds (skip exact duplicates of previous data)
    prev_hashes = set(x_hash(x) for x in prev_X)
    for x in seeds:
        if remaining <= 0:
            break
        h = x_hash(x)
        if h in seen or h in prev_hashes:
            continue
        s = eval_x(x)
        seen.add(h)
        remaining -= 1
        if s < best_s:
            best_x, best_s = x.copy(), s

    if remaining <= 0:
        return {"x": best_x, "score": best_s, "all_attempts": all_attempts}

    # Aggregate observations (prev + current)
    obs_X = np.vstack([np.array([a["x"] for a in all_attempts])] if all_attempts else [np.empty((0, dim))])
    obs_y = np.array([a["score"] for a in all_attempts]) if all_attempts else np.empty((0,))
    if len(prev_y) > 0:
