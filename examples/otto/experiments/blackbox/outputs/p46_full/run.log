                    break

    # Allocate remaining evaluations between BO proposals and locals
    # Use 60% BO, 30% local around top-3, 10% random
    n_bo = int(0.6 * remaining)
    n_loc = int(0.3 * remaining)
    n_rand = remaining - n_bo - n_loc

    # BO loop (batch)
    if n_bo > 0 and X.shape[0] >= 3:
        try:
            gp, ym, ys = fit_gp(X, y)
            cand_order = propose_by_ei(gp, n_bo * 5, X)
            i = 0
            used = 0
            while used < n_bo and i < cand_order.shape[0] and remaining > 0:
                cand = cand_order[i]
                i += 1
                h = x_hash(cand)
                if h in seen:
                    continue
                s = eval_x(cand)
                seen.add(h)
                remaining -= 1
                used += 1
                # update datasets
                X = np.vstack([X, cand])
                y = np.append(y, s)
                if s < best_s:
                    best_s = s
                    best_x = cand.copy()
            # If still have BO budget but ran out of candidates, fill with LHS
            while used < n_bo and remaining > 0:
                cand = rng.uniform(low, high)
                h = x_hash(cand)
                if h in seen:
                    continue
                s = eval_x(cand)
                seen.add(h)
                remaining -= 1
                used += 1
                X = np.vstack([X, cand])
                y = np.append(y, s)
                if s < best_s:
                    best_s = s
                    best_x = cand.copy()
        except Exception:
            # Fallback: random exploration if GP fails
            for _ in range(n_bo):
                if remaining <= 0:
                    break
                cand = rng.uniform(low, high)
                h = x_hash(cand)
                if h in seen:
                    continue
                s = eval_x(cand)
                seen.add(h)
                remaining -= 1
                X = np.vstack([X, cand])
                y = np.append(y, s)
                if s < best_s:
                    best_s = s
                    best_x = cand.copy()

    # Local trust region searches around top few observed points
    if n_loc > 0 and X.shape[0] > 0:
        order = np.argsort(y)
        k_local = min(3, len(order))
        steps_each = max(1, n_loc // k_local)
        for i in range(k_local):
            if remaining <= 0:
                break
            local_trust_search(X[order[i]], steps_each)

    # Final random/perturbation exploration
    for _ in range(max(0, n_rand)):
        if remaining <= 0:
            break
        # Mix random and Gaussian around best
        if rng.random() < 0.6 and best_x is not None:
            cand = rng.multivariate_normal(best_x, np.diag((0.1 * span) ** 2))
            cand = clip(cand)
        else:
            cand = rng.uniform(low, high)
        h = x_hash(cand)
        if h in seen:
            continue
        s = eval_x(cand)
        seen.add(h)
        remaining -= 1
        X = np.vstack([X, cand])
        y = np.append(y, s)
        if s < best_s:
            best_s = s
            best_x = cand.copy()

    # Final best among attempts and previous
    if len(prev_y) > 0:
        idx = int(np.argmin(prev_y))
        if prev_y[idx] < best_s:
            best_x, best_s = prev_X[idx].copy(), float(prev_y[idx])

    if best_x is None:
        # In unlikely case no evals, pick center
        best_x = (low + high) / 2.0
        best_s = float("inf")

    return {"x": best_x, "score": float(best_s), "all_attempts": all_attempts}
