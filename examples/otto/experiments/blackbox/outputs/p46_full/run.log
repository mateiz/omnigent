        # Normalize inputs to [0,1]
        Xn = (X - low) / span
        y_mean, y_std = np.mean(y), np.std(y) if np.std(y) > 1e-12 else 1.0
        yn = (y - y_mean) / y_std
        kernel = C(1.0, (1e-3, 1e3)) * Matern(length_scale=np.ones(dim) * 0.3, length_scale_bounds=(1e-2, 5.0), nu=2.5) + WhiteKernel(noise_level=1e-6, noise_level_bounds=(1e-9, 1e-2))
        gp = GaussianProcessRegressor(kernel=kernel, normalize_y=False, n_restarts_optimizer=2, random_state=rng.integers(0, 1 << 31))
        try:
