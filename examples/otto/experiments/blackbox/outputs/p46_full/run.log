    kernel = C(1.0, (1e-3, 1e3)) * Matern(length_scale=np.clip(span / 3.0, 1e-6, None), nu=2.5) + WhiteKernel(noise_level=1e-6, noise_level_bounds=(1e-9, 1e-2))

