from sklearn.gaussian_process import GaussianProcessRegressor
from sklearn.gaussian_process.kernels import Matern, ConstantKernel as C, WhiteKernel

def solve(objective_function, config, best_xs=None):
    bounds = np.array(config['bounds'], dtype=float)
    dim = int(config.get('dim', bounds.shape[0]))
    budget = int(config.get('budget', 100))
    low, high = bounds[:, 0], bounds[:, 1]
    span = np.maximum(1e-12, high - low)

    rng = np.random.default_rng()
    all_attempts = []

    def clip(x):
        return np.clip(x, low, high)

    def eval_x(x):
        x = np.asarray(x, dtype=float)
        x = clip(x)
        score = float(objective_function(x))
        all_attempts.append({"x": x.copy(), "score": score})
        return score

    # Gather previous data (these don't count against current budget)
    prev_X, prev_y = [], []
    if best_xs:
        for item in best_xs:
            x = np.asarray(item["x"], dtype=float)
            s = float(item["score"])
            prev_X.append(x)
            prev_y.append(s)
    prev_X = np.array(prev_X) if prev_X else np.empty((0, dim))
    prev_y = np.array(prev_y) if prev_y else np.empty((0,))

    # Early return if no budget
    if budget <= 0:
        if len(prev_y) > 0:
            idx = int(np.argmin(prev_y))
            return {"x": prev_X[idx].copy(), "score": float(prev_y[idx]), "all_attempts": []}
        x0 = (low + high) / 2.0
        return {"x": x0, "score": float("inf"), "all_attempts": []}

    # Hash utilities to avoid duplicate evals this call
    def x_hash(x):
        return tuple(np.round(np.asarray(x, dtype=float), 12))

    seen = set()

    # Latin Hypercube Sampling
    def latin_hypercube(n_samples, d, low_b, high_b):
        if n_samples <= 0:
            return np.empty((0, d))
        cut = np.linspace(0, 1, n_samples + 1)
        u = rng.uniform(size=(n_samples, d))
        a = cut[:n_samples]
        b = cut[1:n_samples + 1]
        rdpoints = u * (b - a)[:, None] + a[:, None]
        for j in range(d):
            rng.shuffle(rdpoints[:, j])
        return low_b + rdpoints * (high_b - low_b)

    # Initialize best with previous best if exists
    if len(prev_y) > 0:
        best_idx = int(np.argmin(prev_y))
        best_x, best_s = prev_X[best_idx].copy(), float(prev_y[best_idx])
    else:
        # Evaluate one random point to bootstrap
        x0 = rng.uniform(low, high)
        s0 = eval_x(x0)
        best_x, best_s = x0.copy(), s0

    remaining = budget - len(all_attempts)
    if remaining <= 0:
        return {"x": best_x, "score": best_s, "all_attempts": all_attempts}

    # Form initial seed set: diverse from previous + LHS
    seeds = []
    if len(prev_y) > 0:
