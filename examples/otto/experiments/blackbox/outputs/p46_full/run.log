from scipy.spatial.distance import cdist

def solve(objective_function, config, best_xs=None):
    bounds = np.array(config['bounds'], dtype=float)
    dim = int(config.get('dim', bounds.shape[0]))
    budget = int(config.get('budget', 100))
    low, high = bounds[:, 0], bounds[:, 1]
    span = np.maximum(1e-12, high - low)

    rng = np.random.default_rng()
    all_attempts = []

    def clip(x):
        return np.clip(x, low, high)

    def x_hash(x):
        return tuple(np.round(np.asarray(x, dtype=float), 12))

    def eval_x(x):
        x = np.asarray(x, dtype=float)
        x = clip(x)
        h = x_hash(x)
        if h in eval_x.cache:
            # Do not re-evaluate identical points; but still log once (already logged earlier)
            return eval_x.cache[h]
        score = float(objective_function(x))
        all_attempts.append({"x": x.copy(), "score": score})
        eval_x.cache[h] = score
        return score
    eval_x.cache = {}

    # Load previous data (do not count against budget)
    prev_points = []
    if best_xs:
        for item in best_xs:
            x = np.asarray(item["x"], dtype=float)
            s = float(item["score"])
            prev_points.append((clip(x), s))
        # Populate cache so we avoid re-evaluations of identical points
        for x, s in prev_points:
            eval_x.cache[x_hash(x)] = s

    # Early exit if no budget: return best previous if exists, else center with inf score
    if budget <= 0:
        if prev_points:
            best_prev = min(prev_points, key=lambda t: t[1])
            return {"x": best_prev[0].copy(), "score": best_prev[1], "all_attempts": []}
        x0 = (low + high) / 2.0
        return {"x": x0, "score": float("inf"), "all_attempts": []}

    # Utility: Latin hypercube sampling
    def latin_hypercube(n_samples, dim, low, high):
        if n_samples <= 0:
            return np.empty((0, dim))
        cut = np.linspace(0, 1, n_samples + 1)
        u = rng.uniform(size=(n_samples, dim))
        a = cut[:n_samples]
        b = cut[1:n_samples + 1]
        rdpoints = u * (b - a)[:, None] + a[:, None]
        for j in range(dim):
            rng.shuffle(rdpoints[:, j])
        return low + rdpoints * (high - low)

    # Build working dataset (X, y) from prev_points
    X_known = [x for x, _ in prev_points]
    y_known = [s for _, s in prev_points]

    # Start point and incumbent best
    if prev_points:
        best_x, best_s = min(prev_points, key=lambda t: t[1])
        best_x = best_x.copy()
    else:
        # one initial random eval to anchor
        best_x = rng.uniform(low, high)
        best_s = eval_x(best_x)

    remaining = budget - len(all_attempts)
    if remaining <= 0:
        return {"x": best_x, "score": best_s, "all_attempts": all_attempts}

    # Seed selection: top-K diverse from prev + LHS
    seeds = []
    if prev_points:
        k_prev = max(1, min(10, int(np.sqrt(max(remaining, 1))) + 2))
        prev_sorted = sorted(prev_points, key=lambda t: t[1])[:min(len(prev_points), 100)]
        selected = []
        for x, s in prev_sorted:
            if not selected:
                selected.append((x, s))
            else:
                dists = cdist([x], [p[0] for p in selected])[0]
                if np.all(dists > 1e-6 * np.linalg.norm(span) + 1e-12):
                    selected.append((x, s))
            if len(selected) >= k_prev:
                break
        seeds.extend([x for x, _ in selected])

    n_lhs = max(0, min(remaining // 4, 20))
    if n_lhs > 0:
        lhs = latin_hypercube(n_lhs, dim, low, high)
        for i in range(lhs.shape[0]):
            seeds.append(lhs[i])

    if not seeds:
        seeds = [rng.uniform(low, high)]

    # Evaluate seeds (skip duplicates via cache)
    for x in seeds:
        if remaining <= 0:
            break
        s = eval_x(x)
        if s < best_s:
            best_x, best_s = np.asarray(x, float).copy(), s
        remaining = budget - len(all_attempts)

    if remaining <= 0:
        return {"x": best_x, "score": best_s, "all_attempts": all_attempts}

    # Prepare observed dataset from attempts + prev for local modeling/selection
    obs_X = [a["x"] for a in all_attempts] + X_known
    obs_y = [a["score"] for a in all_attempts] + y_known
    if len(obs_X) == 0:
        obs_X.append(best_x.copy())
        obs_y.append(best_s)

    # Select up to M best distinct points as local starts
    order = np.argsort(obs_y)
    M = min(8, len(order))
    start_points = []
    used = set()
    for i in order[:M]:
        h = x_hash(obs_X[i])
        if h in used:
            continue
        used.add(h)
        start_points.append(obs_X[i])
    if len(start_points) == 0:
        start_points = [best_x.copy()]

    # Trust-region pattern search with adaptive radius and direction set
    base_radius = 0.2 * span
    min_radius = 1e-3 * span
    max_radius = 0.5 * span

    def local_search(x0, steps_budget):
        nonlocal best_x, best_s
        if steps_budget <= 0:
            return 0
        x = clip(np.asarray(x0, float))
        fx = eval_x.cache.get(x_hash(x), None)
        if fx is None:
            fx = eval_x(x)
        if fx < best_s:
            best_x, best_s = x.copy(), fx
        consumed = 0
        radius = base_radius.copy()
        dirs = np.eye(dim)
        no_improve_iters = 0
        while consumed < steps_budget:
            improved = False
            # Evaluate 2*dim axial directions
            for sign in (+1.0, -1.0):
                for d in dirs:
                    if consumed >= steps_budget:
                        break
                    cand = clip(x + sign * radius * d)
                    fc = eval_x(cand)
                    consumed += 1
                    if fc < best_s:
                        best_x, best_s = cand.copy(), fc
                    if fc + 1e-12 < fx:
                        x, fx = cand, fc
                        improved = True
                if consumed >= steps_budget:
                    break
            if improved:
                # modest expansion after improvement
                radius = np.minimum(max_radius, radius * 1.5)
                no_improve_iters = 0
            else:
                # shrink when no improvement
                radius = np.maximum(min_radius, radius * 0.5)
                no_improve_iters += 1
                if np.allclose(radius, min_radius) and no_improve_iters >= 2:
                    break
        return consumed

    # Allocate remaining evaluations among locals and global exploration
    # Heuristic split depending on data availability
    if len(prev_points) > 0 or len(all_attempts) > 5:
        frac_local = 0.6
    else:
        frac_local = 0.4
    local_budget = int(frac_local * remaining)
    global_budget = remaining - local_budget

    # Distribute local budget across start points
    n_locals = min(len(start_points), max(1, local_budget // max(2, dim)))
    if n_locals <= 0:
        n_locals = 1
    steps_per_local = max(2 * dim, local_budget // n_locals if n_locals > 0 else 0)

    for i in range(n_locals):
        if (budget - len(all_attempts)) <= 0:
            break
        local_steps_left = min(steps_per_local, budget - len(all_attempts))
        if local_steps_left <= 0:
            break
        local_search(start_points[i % len(start_points)], local_steps_left)

    remaining = budget - len(all_attempts)
    if remaining <= 0:
        return {"x": best_x, "score": best_s, "all_attempts": all_attempts}

    # Surrogate-guided global exploration using RBF (cubic)
    # Fit simple RBF to known data for acquisition = predicted - k*uncertainty
    def fit_rbf(X, y, eps=1e-8):
        X = np.asarray(X, float)
        y = np.asarray(y, float)
        if len(X) < 3:
            return None
        D = cdist(X, X)
        K = D**3 + eps * np.eye(len(X))
        try:
            w = np.linalg.solve(K, y)
        except np.linalg.LinAlgError:
            # fallback to ridge
            w = np.linalg.lstsq(K, y, rcond=None)[0]
        return (X, w)

    def rbf_predict(model, Z):
        if model is None:
            return np.full((len(Z),), np.inf)
        X, w = model
        D = cdist(Z, X)
        K = D**3
        return K @ w

    # Build dataset for surrogate
    obs_X = [a["x"] for a in all_attempts] + X_known
    obs_y = [a["score"] for a in all_attempts] + y_known
    # Deduplicate
    dedup = {}
    for x, s in zip(obs_X, obs_y):
        h = x_hash(x)
        if h not in dedup or s < dedup[h][1]:
            dedup[h] = (np.asarray(x, float), float(s))
    obs_X = [v[0] for v in dedup.values()]
    obs_y = [v[1] for v in dedup.values()]

    rbf_model = fit_rbf(obs_X, obs_y)

    # Generate candidate pool: mix of LHS, Gaussian around bests, edges
    n_cand = max(50, 5 * dim)
    lhs_cand = latin_hypercube(n_cand // 2, dim, low, high)
    # Gaussian around top few points
    top_idx = np.argsort(obs_y)[:min(5, len(obs_y))]
    tops = [obs_X[i] for i in top_idx] if len(top_idx) > 0 else [best_x]
    gauss = []
    cov = np.diag((0.15 * span) ** 2)
    for i in range(n_cand - len(lhs_cand)):
        base = tops[i % len(tops)]
        gauss.append(clip(rng.multivariate_normal(mean=base, cov=cov)))
    cand_pool = np.vstack([lhs_cand, np.array(gauss)]) if len(lhs_cand) > 0 else np.array(gauss)

    # Density penalty to avoid crowded regions
    if len(obs_X) > 0:
        dmat = cdist(cand_pool, np.asarray(obs_X))
        min_d = np.min(dmat, axis=1)
    else:
        min_d = np.ones(len(cand_pool)) * np.linalg.norm(span)

    # Score candidates via surrogate with exploration bonus proportional to distance
    pred = rbf_predict(rbf_model, cand_pool) if rbf_model is not None else np.zeros(len(cand_pool))
    # Normalize components
    if np.isfinite(pred).any():
        pmin, pmax = np.nanmin(pred), np.nanmax(pred)
        pred_norm = (pred - pmin) / (pmax - pmin + 1e-12)
    else:
        pred_norm = np.zeros_like(pred)
    d_norm = 1.0 - (min_d / (np.linalg.norm(span) + 1e-12))
    # Acquisition: lower is better
    acq = pred_norm + 0.25 * d_norm

    # Pick best global candidates by acquisition
    order = np.argsort(acq)
    n_pick = min(remaining, len(order))
    picked = cand_pool[order[:n_pick]]

    # Evaluate picked candidates
    for i in range(n_pick):
        if (budget - len(all_attempts)) <= 0:
            break
        s = eval_x(picked[i])
        if s < best_s:
            best_x, best_s = picked[i].copy(), s

    # If budget still remains (due to duplicates skipped), fill with uniform random
    remaining = budget - len(all_attempts)
    while remaining > 0:
        cand = rng.uniform(low, high)
        s = eval_x(cand)
        if s < best_s:
            best_x, best_s = cand.copy(), s
        remaining = budget - len(all_attempts)

    return {"x": best_x, "score": best_s, "all_attempts": all_attempts}
