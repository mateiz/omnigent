        a = cut[:n_samples]
        b = cut[1:n_samples + 1]
        rd = u * (b - a)[:, None] + a[:, None]
        for j in range(dim):
            rng.shuffle(rd[:, j])
        return low + rd * (high - low)

    def x_hash(x):
        return tuple(np.round(np.asarray(x, float), 12))

