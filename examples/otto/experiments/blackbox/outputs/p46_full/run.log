        order = np.argsort(obs_y)
        topX = obs_X[order[:min(5, len(order))]] if len(order) > 0 else np.array([best_x])
        locs = []
        cov = (0.10 * span) ** 2
        for i in range(m):
            base = topX[i % len(topX)]
            locs.append(clip(rng.normal(base, np.sqrt(cov))))
        cands = np.vstack([cand_global, np.array(locs)]) if locs else cand_global
        # Score by LCB
        Xn = (cands - low) / span
        try:
            mu, std = gp.predict(Xn, return_std=True)
            kappa = 2.0
            acq = mu - kappa * std  # lower is better
            order = np.argsort(acq)
            return cands[order]
        except Exception:
            return cands

    # Trust-region local pattern search around a few best points
    # Prepare cache of evaluated points to compare
    eval_cache = {}
    for a in all_attempts:
        eval_cache[x_hash(a["x"])] = a["score"]
    for i in range(len(prev_y)):
        eval_cache[x_hash(prev_X[i])] = float(prev_y[i])

    def local_search(x0, steps_budget):
        nonlocal best_x, best_s, remaining
        if steps_budget <= 0 or remaining <= 0:
            return
        x = clip(np.asarray(x0, dtype=float))
        # Initialize radius relative to span
        radius = 0.2 * span
        min_radius = 1e-3 * span
        directions = np.vstack([np.eye(dim), -np.eye(dim)])
        # Best known score at x
        sx = eval_cache.get(x_hash(x), None)
        if sx is None and remaining > 0:
            sx = eval_x(x)
            eval_cache[x_hash(x)] = sx
            seen.add(x_hash(x))
            remaining -= 1
            if sx < best_s:
                best_x, best_s = x.copy(), sx
        if sx is None:
            return
        while steps_budget > 0 and remaining > 0:
            improved = False
            # Try coordinate moves
            for d in directions:
                if steps_budget <= 0 or remaining <= 0:
                    break
                cand = clip(x + d * radius)
                h = x_hash(cand)
                if h in seen:
                    steps_budget -= 1  # count attempt slot even if duplicate try to balance local/global
                    continue
                s = eval_x(cand)
                seen.add(h)
                remaining -= 1
                steps_budget -= 1
                eval_cache[h] = s
                if s < best_s:
                    best_x, best_s = cand.copy(), s
                if s + 1e-12 < sx:
                    x, sx = cand, s
                    improved = True
            if not improved:
                radius = np.maximum(min_radius, 0.5 * radius)
                if np.allclose(radius, min_radius):
                    break

    # Choose points for local search: best from observed
    if obs_X.shape[0] > 0:
        order = np.argsort(obs_y)
        starts = [obs_X[i] for i in order[:min(5, len(order))]]
    else:
        starts = [best_x]

    # Allocate budget: 40% local, 40% GP-guided, 20% random
    n_local = int(0.4 * remaining)
    n_gp = int(0.4 * remaining)
    n_rand = remaining - n_local - n_gp

    # Local searches
    if n_local > 0:
        n_starts = min(len(starts), max(1, n_local // max(2, dim)))
        steps_per_local = max(2, n_local // n_starts)
        for i in range(n_starts):
            if remaining <= 0:
                break
            local_search(starts[i], steps_per_local)

    if remaining <= 0:
        return {"x": best_x, "score": best_s, "all_attempts": all_attempts}

    # GP-guided proposals
    if n_gp > 0:
        cands = propose_gp_candidates(n_gp * 3)  # generate more and filter unique
        for x in cands:
            if remaining <= 0:
                break
            h = x_hash(x)
            if h in seen:
                continue
            s = eval_x(x)
            seen.add(h)
            remaining -= 1
            if s < best_s:
                best_x, best_s = x.copy(), s
            if len(seen) >= n_gp:
                break

    if remaining <= 0:
        return {"x": best_x, "score": best_s, "all_attempts": all_attempts}

    # Final random/global exploration: mix uniform and Gaussian around best
    n_gauss = remaining // 2
    n_uniform = remaining - n_gauss
    # Gaussian around top few
    if n_gauss > 0:
        order = np.argsort(obs_y) if obs_X.shape[0] > 0 else np.array([0])
        topX = obs_X[order[:min(5, len(order))]] if obs_X.shape[0] > 0 else np.array([best_x])
        cov = (0.08 * span) ** 2
        for i in range(n_gauss):
            if remaining <= 0:
                break
            base = topX[i % len(topX)]
            cand = clip(rng.normal(base, np.sqrt(cov)))
            h = x_hash(cand)
            if h in seen:
                continue
            s = eval_x(cand)
            seen.add(h)
            remaining -= 1
            if s < best_s:
                best_x, best_s = cand.copy(), s

    # Uniform for rest
    for _ in range(max(0, n_uniform)):
        if remaining <= 0:
            break
        cand = rng.uniform(low, high)
        h = x_hash(cand)
        if h in seen:
            continue
        s = eval_x(cand)
        seen.add(h)
        remaining -= 1
        if s < best_s:
            best_x, best_s = cand.copy(), s

    return {"x": best_x, "score": best_s, "all_attempts": all_attempts}
